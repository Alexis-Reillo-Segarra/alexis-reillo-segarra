---
import { Image } from 'astro:assets';
import Character from './Character.astro';
import TechBadge from './TechBadge.astro';
import Icon from './Icon.astro';
import { languages, paths, useTranslations, type Lang } from '../i18n/ui';
import { aboutLines, bag, certifications, journey, profile, projects, skillGroups } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [roleA, roleB] = profile.role.split(' | ');
const number = (i: number) => `No. ${String(i + 1).padStart(3, '0')}`;
---

<div class="m">
  <a class="skip-link" href="#m-main">{t('nav.skip')}</a>

  <header class="m-bar px">
    <a class="m-bar__brand" href="#m-top" aria-label={profile.name}>AR</a>
    <ul class="m-bar__langs">
      {
        (Object.keys(languages) as Lang[]).map((code) => (
          <li>
            <a
              href={paths[code]}
              hreflang={code}
              lang={code}
              aria-label={languages[code]}
              aria-current={code === lang ? 'true' : undefined}
            >
              {code}
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <main id="m-main">
    <section class="m-sec m-hero" id="m-top">
      <div class="m-wrap m-hero__col">
        <p class="px m-hero__status">
          <span class="m-hero__dot" aria-hidden="true"></span>
          {t('hero.available')}
        </p>
        <h1 class="m-hero__name">{profile.name}</h1>
        <p class="m-hero__role">
          {roleA} <span aria-hidden="true">·</span> <em>{roleB}</em>
        </p>

        <aside class="m-card window" aria-label={t('hero.card')}>
          <div class="m-card__screen">
            <Character crop="bust" label={t('hero.avatar')} />
          </div>
          <dl class="m-card__stats px">
            <div>
              <dt>{t('hero.base')}</dt>
              <dd>{profile.location}</dd>
            </div>
            <div>
              <dt>{t('hero.status')}</dt>
              <dd>{t('hero.statusShort')}</dd>
            </div>
            <div>
              <dt>{t('hero.since')}</dt>
              <dd>{profile.activeSince}</dd>
            </div>
          </dl>
        </aside>

        <a class="btn btn--primary px" href="#m-contact">{t('hero.cta')}</a>
  </div>
    </section>

    <section class="m-sec" id="m-about">
      <div class="m-wrap">
        <h2 class="px section-label">{t('about.label')}</h2>
        <div class="m-about window">
          <span class="m-about__nameplate px">{profile.shortName}</span>
          {aboutLines[lang].map((line) => <p>{line}</p>)}
        </div>
        <div class="m-bag px">
          <h3 class="m-bag__title">{t('about.bag')}</h3>
          <ul>
            {bag.map((item) => <li>{item[lang]}</li>)}
          </ul>
        </div>
  </div>
    </section>

    <section class="m-sec m-sec--tinted" id="m-journey">
      <div class="m-wrap">
        <header class="section-head">
          <p class="px section-label">{t('journey.label')}</p>
          <h2 class="section-title">{t('journey.title')}</h2>
        </header>
        <ol class="m-route">
          {
            journey.map((stop, i) => (
              <li class="m-stop">
                <article class="m-stop__card window">
                  <header class="px m-stop__head">
                    <span class:list={['m-stop__kind', `m-stop__kind--${stop.kind}`]}>{t(`journey.${stop.kind}`)}</span>
                    <span>{number(i)}</span>
                  </header>
                  <h3 class="m-stop__org">{stop.org}</h3>
                  <p>{stop.role[lang]}</p>
                  <p class="px m-stop__meta">
                    {stop.period[lang]}
                    <br />
                    {stop.place}
                  </p>
                  {
                    stop.stack && (
                      <ul class="px m-tags">
                        {stop.stack.map((name) => (
                          <TechBadge name={name} />
                        ))}
                      </ul>
                    )
                  }
                </article>
              </li>
            ))
          }
          <li class="m-stop m-stop--next">
            <p class="px section-label">{t('journey.nextTitle')}</p>
            <p class="m-stop__org">{t('journey.nextText')}</p>
          </li>
        </ol>
  </div>
    </section>

    <section class="m-sec" id="m-skills">
      <div class="m-wrap">
        <header class="section-head">
          <p class="px section-label">{t('skills.label')}</p>
          <h2 class="section-title">{t('skills.title')}</h2>
        </header>
        <div class="m-skills window">
          {
            skillGroups.map((group) => (
              <div class="m-skills__row">
                <h3 class="px m-skills__type" style={`--type: var(--${group.color})`}>
                  <span class="sr-only">{t('skills.type')}: </span>
                  {group.type[lang]}
                </h3>
                <ul class="px m-tags">
                  {group.skills.map((skill) => (
                    <TechBadge name={skill} />
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="px m-cert">
          <span class="m-cert__medal" aria-hidden="true"></span>
          {t('skills.cert')}: {certifications.join(' · ')}
        </p>
  </div>
    </section>

    <section class="m-sec" id="m-projects">
      <div class="m-wrap">
        <header class="section-head">
          <p class="px section-label">{t('projects.label')}</p>
          <h2 class="section-title">{t('projects.title')}</h2>
        </header>
        <ul class="m-projects">
          {
            projects.map((project, i) => (
              <li class="m-entry window">
                <p class="px m-entry__no">
                  <span>{number(i)}</span>
                  {project.status && <span class="m-entry__status">{project.status[lang]}</span>}
                </p>
                <Image
                  class="m-entry__shot"
                  src={project.image}
                  alt={project.imageAlt[lang]}
                  widths={[480, 800]}
                  sizes="(min-width: 40rem) 36rem, 90vw"
                  style={project.imagePosition ? `object-position: ${project.imagePosition}` : undefined}
                />
                <h3 class="m-entry__name">{project.name}</h3>
                <p class="m-entry__text">{project.description[lang]}</p>
                <ul class="px m-tags">
                  {project.stack.map((name) => (
                    <TechBadge name={name} />
                  ))}
                </ul>
                {
                  (project.url || project.repo) && (
                    <p class="px m-entry__links">
                      {project.url && (
                        <a href={project.url} target="_blank" rel="noopener noreferrer">
                          <Icon name="external" />
                          {t('projects.demo')}
                        </a>
                      )}
                      {project.repo && (
                        <a href={project.repo} target="_blank" rel="noopener noreferrer">
                          <Icon name="github" />
                          {t('projects.repo')}
                        </a>
                      )}
                    </p>
                  )
                }
              </li>
            ))
          }
        </ul>
  </div>
    </section>

    <section class="m-sec m-contact" id="m-contact">
      <div class="m-wrap">
        <header class="section-head">
          <p class="px section-label">{t('contact.label')}</p>
          <h2 class="section-title">{t('contact.title')}</h2>
          <a class="m-contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </header>
        <ul class="m-contact__menu px">
          <li><a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" />{t('contact.email')}</a></li>
          <li>
            <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer"
              ><Icon name="linkedin" />{t('contact.linkedin')}</a
            >
          </li>
          <li>
            <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer"
              ><Icon name="github" />{t('contact.github')}</a
            >
          </li>
        </ul>

        <footer class="m-foot px">
          <p>© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
          <p>{t('mobile.desktop')}</p>
        </footer>
  </div>
    </section>
  </main>
</div>

<style>
  /*
   * The whole site for narrow screens: the same content as the stage, laid out as one plain column.
   * No intro, no sound, no travelling guide, and no script.
   */
  .m {
    --m-max: 36rem;
  }

  .m-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--hud-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .m-bar__brand {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: 0.5rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
  }

  .m-bar__langs {
    display: flex;
    border: 2px solid var(--ink);
    border-radius: 6px;
    overflow: hidden;
  }

  .m-bar__langs a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
  }

  .m-bar__langs a[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .m-sec {
    padding: 3.5rem var(--gutter);
  }

  .m-wrap {
    max-width: var(--m-max);
    margin-inline: auto;
  }

  .m-sec--tinted {
    background: var(--bg-2);
    border-block: 1px solid var(--rule);
  }

  .m-sec :global(.section-head) {
    margin-bottom: 1.75rem;
  }

  /* ---------- Hero ---------- */

  .m-hero {
    padding-block: 2.5rem 1.5rem;
  }

  /* No caret to leave room for: nothing hovers on a touch screen */
  .m .btn {
    padding-inline: 1.25rem;
  }

  .m-hero__col {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .m-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .m-hero__dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    background: #4f9d5d;
    animation: blink 1.4s steps(1) infinite;
  }

  .m-hero__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 13vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .m-hero__role {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .m-hero__role em {
    color: var(--accent-ink);
  }

  .m-card {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    width: 100%;
    margin-block: 0.75rem;
    padding: 1rem;
  }

  .m-card__screen {
    border: 3px solid var(--ink);
    border-radius: 6px;
    background-color: var(--bg-2);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 12%, transparent) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    overflow: hidden;
  }

  .m-card__screen :global(.character) {
    width: 100%;
  }

  .m-card__stats {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8125rem;
  }

  .m-card__stats div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px dotted var(--rule);
  }

  .m-card__stats dt {
    color: var(--ink-2);
  }

  /* ---------- About ---------- */

  .m-about {
    position: relative;
    display: grid;
    gap: 0.6rem;
    margin-top: 2rem;
    padding: 1.6rem 1.25rem 1.25rem;
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .m-about__nameplate {
    position: absolute;
    left: 1rem;
    top: 0;
    padding: 0.1rem 0.7rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
    transform: translateY(-50%);
  }

  .m-bag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1.25rem;
  }

  .m-bag__title {
    font: inherit;
    color: var(--ink-2);
  }

  .m-bag ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .m-bag li {
    padding: 0.3rem 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--paper);
  }

  /* ---------- Journey: the stage's route, turned to run down the page ---------- */

  .m-route {
    --node: 1.25rem;
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding-left: calc(var(--node) + 1rem);
  }

  .m-route::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2 - 2px);
    top: 0.5rem;
    bottom: 1.5rem;
    width: 4px;
    background: repeating-linear-gradient(to bottom, var(--ink) 0 12px, transparent 12px 20px);
    opacity: 0.55;
  }

  .m-stop {
    position: relative;
  }

  .m-stop::before {
    content: '';
    position: absolute;
    left: calc(-1 * (var(--node) + 1rem));
    top: 1.4rem;
    width: var(--node);
    height: var(--node);
    background: var(--accent);
    border: 3px solid var(--ink);
    box-shadow: inset 0 0 0 2px var(--paper);
  }

  .m-stop--next {
    display: grid;
    gap: 0.4rem;
    padding-block: 0.25rem;
  }

  .m-stop--next::before {
    top: 0.25rem;
    background: var(--paper);
    animation: m-pulse 1.1s steps(1) infinite;
  }

  @keyframes m-pulse {
    50% {
      background: var(--accent);
    }
  }

  .m-stop__card {
    display: grid;
    gap: 0.4rem;
    padding: 1.2rem 1.25rem 1.3rem;
  }

  .m-stop__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .m-stop__kind {
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    color: var(--paper);
    background: var(--olive);
  }

  .m-stop__kind--work {
    background: var(--accent-ink);
  }

  .m-stop__org {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .m-stop__meta {
    margin-top: 0.4rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .m-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8125rem;
  }

  .m-stop .m-tags {
    margin-top: 0.4rem;
  }

  /* ---------- Skills ---------- */

  .m-skills {
    padding: 0.5rem 1.25rem;
  }

  .m-skills__row {
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    padding-block: 1rem;
  }

  .m-skills__row + .m-skills__row {
    border-top: 2px dotted var(--rule);
  }

  .m-skills__type {
    padding: 0.2rem 0.7rem;
    border-radius: 4px;
    /* Like the tech badges, it keeps its colours when the theme changes */
    --ink: #191918;
    --paper: #fffdf8;
    color: var(--paper);
    background: color-mix(in srgb, var(--type) 78%, var(--ink));
    box-shadow: inset 0 -3px 0 rgba(25, 25, 24, 0.25);
  }

  .m-skills .m-tags {
    gap: 0.5rem;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .m-cert {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
  }

  .m-cert__medal {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--ochre);
    border: 2px solid var(--ink);
    transform: rotate(45deg);
  }

  /* ---------- Projects ---------- */

  .m-projects {
    display: grid;
    gap: 1.5rem;
  }

  .m-entry {
    display: grid;
    gap: 0.6rem;
    padding: 1.2rem 1.25rem 1.3rem;
  }

  .m-entry__no {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .m-entry__status {
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    color: var(--paper);
    background: var(--accent-ink);
  }

  .m-entry :global(.m-entry__shot) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 3px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
  }

  .m-entry__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .m-entry__text {
    color: var(--ink-2);
  }

  .m-entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .m-entry__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* ---------- Contact ---------- */

  .m-contact {
    background: var(--ink);
    color: var(--paper);
    padding-bottom: 2rem;
  }

  .m-contact :global(.section-label) {
    color: var(--accent-inv);
  }

  .m-contact__email {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .m-contact__menu {
    display: grid;
    gap: 0.75rem;
  }

  .m-contact__menu .btn {
    width: 100%;
    min-height: 3.25rem;
    color: var(--ink);
    font-size: 1rem;
  }

  .m-foot {
    display: grid;
    gap: 0.4rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
    color: color-mix(in srgb, var(--paper) 65%, transparent);
    font-size: 0.8125rem;
  }
</style>
