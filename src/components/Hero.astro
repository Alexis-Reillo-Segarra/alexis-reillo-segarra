---
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="top">
  <h1>{profile.name}<span class="cursor" aria-hidden="true">_</span></h1>
  <p class="role">{profile.role} <span class="place"><span class="n">—</span> {profile.location}</span></p>
  <figure class="quote">
    <blockquote><p>{t('hero.quote')}</p></blockquote>
    <figcaption>Albert Camus</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    align-content: end;
    min-height: 100svh;
    padding: 7rem var(--gutter) clamp(2.5rem, 9vh, 5.5rem);
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.25rem, 5.6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .role {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
  }

  /* The dash travels with the place when the line wraps */
  .place {
    white-space: nowrap;
  }

  .quote {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25ch;
    margin-top: clamp(2.5rem, 8vh, 4.5rem);
    color: var(--faint);
    font-size: 0.9375rem;
  }

  figcaption::before {
    content: '— ';
  }

  /* On a narrow screen the name sits over the drawing: a shade underneath keeps it readable */
  @media (max-width: 48rem) {
    .hero {
      background: linear-gradient(rgb(13 17 23 / 0) 55%, rgb(13 17 23 / 0.85) 82%);
    }
  }
</style>
