---
import { tech } from '../data/tech';

interface Props {
  /** The technology as it is written in the content; one without a brand on file stays a plain tag. */
  name: string;
}

const { name } = Astro.props;
const brand = tech[name];
---

{
  brand ? (
    <li class:list={['type', { 'type--pale': brand.pale }]} style={`--tech: ${brand.color}`}>
      <img class="type__logo" src={brand.logo} alt="" width="14" height="14" loading="lazy" />
      {name}
    </li>
  ) : (
    <li class="type type--plain">{name}</li>
  )
}

<style>
  /* A technology worn like a type badge: its brand colour, its logo on a paper disc */
  .type {
    /* A brand's colours are its own: the badge stays as it is when the theme changes */
    --ink: #191918;
    --paper: #fffdf8;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.65rem 0.15rem 0.2rem;
    border-radius: 999px;
    color: var(--paper);
    /* Darkened so the paper-coloured lettering keeps AA contrast */
    background: color-mix(in srgb, var(--tech) 78%, var(--ink));
    box-shadow: inset 0 -3px 0 rgba(25, 25, 24, 0.25);
    white-space: nowrap;
  }

  /* Brand colours too pale for light lettering */
  .type--pale {
    color: var(--ink);
    background: var(--tech);
  }

  .type--plain {
    padding: 0.1rem 0.5rem;
    border: 2px solid;
    border-radius: 4px;
    color: inherit;
    background: none;
    box-shadow: none;
  }

  .type__logo {
    box-sizing: content-box;
    width: 0.875rem;
    height: 0.875rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--paper);
    object-fit: contain;
  }
</style>
