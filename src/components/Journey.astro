---
import { useTranslations, type Lang } from '../i18n/ui';
import TechBadge from './TechBadge.astro';
import { journey } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="journey" id="journey" data-journey>
  <div class="journey__view">
    <div class="journey__track" data-journey-track>
      <div class="stage-prop stage-prop--left ladder journey__way-in" data-journey-in aria-hidden="true"></div>
      <div class="panel panel--intro">
        <p class="px section-label">{t('journey.label')}</p>
        <h2 class="section-title">{t('journey.title')}</h2>
        <p class="px journey__hint" aria-hidden="true">{t('journey.hint')} <span class="journey__hint-arrow"></span></p>
      </div>

      <ol class="journey__stops">
        {
          journey.map((stop, i) => (
            <li class="panel stop" data-stop={`stop-${i}`}>
              <span class="stop__node" data-node aria-hidden="true" />
              <article class="stop__card window">
                <header class="px stop__head">
                  <span class:list={['stop__kind', `stop__kind--${stop.kind}`]}>{t(`journey.${stop.kind}`)}</span>
                  <span>No. {String(i + 1).padStart(3, '0')}</span>
                </header>
                <h3 class="stop__org">{stop.org}</h3>
                <p class="stop__role">{stop.role[lang]}</p>
                <p class="px stop__meta">
                  {stop.period[lang]}
                  <br />
                  {stop.place}
                </p>
                {
                  stop.stack && (
                    <ul class="px stop__stack">
                      {stop.stack.map((name) => (
                        <TechBadge name={name} />
                      ))}
                    </ul>
                  )
                }
              </article>
            </li>
          ))
        }
      </ol>

      <div class="panel panel--next" data-stop="next">
        <span class="stop__node stop__node--next" data-node aria-hidden="true"></span>
        <p class="px section-label">{t('journey.nextTitle')}</p>
        <p class="section-title">{t('journey.nextText')}</p>
        <a class="btn btn--primary caret px" href="#contact">{t('journey.nextCta')}</a>
      </div>
      <div class="stage-prop ladder journey__way-out" aria-hidden="true"></div>
    </div>
  </div>

  <div class="journey__exp px" aria-hidden="true">
    <span>EXP</span>
    <span class="journey__bar"><span class="journey__fill" data-journey-fill></span></span>
  </div>
</section>

<style>
  .journey {
    /* Height of the route line inside the pinned section; Alexis walks on it */
    --route-y: calc(var(--hud-h) + (100svh - var(--hud-h)) * 0.3);
    position: relative;
    background: var(--bg-2);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }

  /* A ladder at either end of the route, travelling with it: he comes down onto its start and leaves below its last node */
  .journey__way-in {
    top: 0;
    height: var(--route-y);
  }

  .journey__way-out {
    top: calc(var(--route-y) + 4px);
    bottom: 0;
    right: calc(var(--gutter) + 0.75rem - var(--prop-w) / 2);
  }

  /*
   * The window the route is seen through. It spans the screen, so nothing the stage measures moves,
   * but on a monitor wider than the page it only shows as far as the lanes: the stops come into the
   * content column and fade out of it, rather than trailing off to the edge of the screen.
   */
  .journey.is-horizontal .journey__view {
    --edge: max(0px, var(--side) - 2 * var(--lane-reach));
    --fade: min(var(--edge), 5rem);
    mask-image: linear-gradient(
      90deg,
      transparent calc(var(--edge) - var(--fade)),
      #000 var(--edge),
      #000 calc(100% - var(--edge)),
      transparent calc(100% - var(--edge) + var(--fade))
    );
  }

  .journey__track {
    position: relative;
    display: flex;
    width: max-content;
    height: 100svh;
    min-height: 34rem;
    padding-top: var(--hud-h);
    will-change: transform;
  }

  /* The route: a dashed pixel line running behind every stop */
  .journey__track::before {
    content: '';
    position: absolute;
    left: calc(var(--lane) - var(--prop-w) / 2);
    right: calc(var(--gutter) + 0.75rem);
    top: var(--route-y);
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--ink) 0 12px, transparent 12px 20px);
    opacity: 0.55;
  }

  .journey__stops {
    display: flex;
  }

  .panel {
    position: relative;
    flex: none;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    padding-inline: var(--gutter);
  }

  /* A full screen wide: Alexis comes down at its left edge and crosses it on his way to the first stop */
  .panel--intro {
    width: 100vw;
    padding-inline: var(--side);
  }

  .journey__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    color: var(--ink-2);
  }

  .journey__hint-arrow {
    border: 0.4rem solid transparent;
    border-left: 0.6rem solid var(--accent);
    border-right: 0;
    animation: nudge 0.7s steps(2) infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateX(5px);
    }
  }

  .stop {
    width: 34rem;
    max-width: 80vw;
    align-content: start;
    padding-top: calc((100svh - var(--hud-h)) * 0.3 + 3.5rem);
  }

  /* Each stop hangs to the left of its node, so the card is fully on screen when Alexis reaches it */
  .stop__node {
    position: absolute;
    right: var(--gutter);
    top: calc((100svh - var(--hud-h)) * 0.3 - 0.75rem + 2px);
    width: 1.5rem;
    height: 1.5rem;
    background: var(--accent);
    border: 3px solid var(--ink);
    box-shadow: inset 0 0 0 3px var(--paper);
  }

  .stop__node::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 3px;
    height: 2.4rem;
    margin-left: -1.5px;
    background: var(--ink);
  }

  .stop__node--next {
    background: var(--paper);
    animation: pulse 1.1s steps(1) infinite;
  }

  @keyframes pulse {
    50% {
      background: var(--accent);
    }
  }

  .stop__node--next::after {
    display: none;
  }

  .stop__card {
    width: 100%;
    display: grid;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .stop__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .stop__kind {
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    color: var(--paper);
    background: var(--olive);
  }

  .stop__kind--work {
    background: var(--accent-ink);
  }

  .stop__org {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .stop__role {
    font-size: 1.0625rem;
  }

  .stop__meta {
    margin-top: 0.5rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .stop__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
  }

  .panel--next {
    width: 34rem;
    max-width: 80vw;
    align-content: start;
    padding-top: calc((100svh - var(--hud-h)) * 0.3 + 3.5rem);
  }

  .journey__exp {
    position: absolute;
    left: var(--side);
    right: calc(var(--side) + 1rem);
    bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-2);
  }

  .journey__bar {
    flex: 1;
    height: 0.75rem;
    padding: 2px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .journey__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--sky);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* Stacked layout: small screens, reduced motion or no JS. The stage opts in with .is-horizontal. */
  .journey:not(.is-horizontal) {
    padding: clamp(5rem, 12vh, 9rem) var(--gutter);
  }

  .journey:not(.is-horizontal) .journey__track {
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    height: auto;
    min-height: 0;
    padding-top: 0;
  }

  .journey:not(.is-horizontal) .journey__track::before,
  .journey:not(.is-horizontal) .journey__hint,
  .journey:not(.is-horizontal) .journey__exp,
  .journey:not(.is-horizontal) .stop__node {
    display: none;
  }

  .journey:not(.is-horizontal) .journey__stops {
    flex-direction: column;
    gap: 1.5rem;
  }

  .journey:not(.is-horizontal) .panel {
    width: 100%;
    max-width: 40rem;
    min-width: 0;
    padding: 0;
  }
</style>
