---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  lines: string[];
  /** Started from script instead of when it scrolls into view. */
  manual?: boolean;
  /** Keeps the «next» arrow on the last line so one more press closes it. */
  closable?: boolean;
  class?: string;
}

const { lang, lines, manual = false, closable = false, class: className } = Astro.props;
const t = useTranslations(lang);
---

<div
  class:list={['dialog window', className]}
  data-dialog
  data-lines={JSON.stringify(lines)}
  data-manual={manual ? '' : undefined}
  data-closable={closable ? '' : undefined}
  data-state="idle"
>
  <p class="sr-only">{lines.join(' ')}</p>
  <p class="dialog__text" data-dialog-text aria-hidden="true"></p>
  <noscript><p class="dialog__text">{lines.join(' ')}</p></noscript>
  <button class="dialog__next" type="button" aria-label={t('dialog.next')} data-dialog-next></button>
</div>
