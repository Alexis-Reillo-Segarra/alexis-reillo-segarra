---
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const handle = (url: string) => new URL(url).pathname.replace(/^\/|\/$/g, '');
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <h2 class="section__title" id="contact-title"><span class="n">03</span>{t('nav.contact')}</h2>
  <p class="lead">{t('contact.lead')}</p>
  <dl class="channels">
    <div>
      <dt>email</dt>
      <dd>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="copy" type="button" data-copy={profile.email} data-done={t('contact.copied')}>
          {t('contact.copy')}
        </button>
        <span class="sr-only" role="status" data-copy-status data-message={t('contact.copiedMsg')}></span>
      </dd>
    </div>
    <div>
      <dt>linkedin</dt>
      <dd><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{handle(profile.linkedin)} ↗</a></dd>
    </div>
    <div>
      <dt>github</dt>
      <dd><a href={profile.github} target="_blank" rel="noopener noreferrer">{handle(profile.github)} ↗</a></dd>
    </div>
  </dl>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && status) {
    const label = button.textContent;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.textContent = button.dataset.done ?? '';
      status.textContent = status.dataset.message ?? '';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = label;
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .lead {
    margin-bottom: 2.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .channels {
    border-top: 1px solid var(--line);
  }

  .channels div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
  }

  dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    overflow-wrap: anywhere;
  }

  .copy {
    color: var(--muted);
    transition: color 0.15s ease-out;
  }

  .copy::before {
    content: '[';
  }

  .copy::after {
    content: ']';
  }

  .copy:hover {
    color: var(--fg);
  }

  @media (max-width: 30rem) {
    .channels div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
