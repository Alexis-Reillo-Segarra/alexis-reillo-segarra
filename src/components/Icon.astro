---
/* What a link does, at a glance: a small glyph in front of its label. Decorative, the label says it too. */
interface Props {
  name: keyof typeof icons;
}

const icons = {
  mail: { line: true, d: 'M1.75 3.5h12.5v9H1.75zM2 4l6 4.5L14 4' },
  copy: { line: true, d: 'M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3' },
  external: { line: true, d: 'M6.5 3.5h-3v9h9v-3M9.5 2.5h4v4M13.5 2.5l-6 6' },
  github: {
    line: false,
    d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z',
  },
  linkedin: {
    line: false,
    d: 'M2.5 1h11A1.5 1.5 0 0115 2.5v11a1.5 1.5 0 01-1.5 1.5h-11A1.5 1.5 0 011 13.5v-11A1.5 1.5 0 012.5 1zM4.6 3.5a1.1 1.1 0 100 2.2 1.1 1.1 0 000-2.2zM3.7 6.8v5.7h1.8V6.8zM6.9 6.8v5.7h1.8V9.7c0-.8.3-1.4 1.1-1.4.75 0 .85.6.85 1.3v2.9h1.8V9.15c0-1.45-.4-2.5-2-2.5-.9 0-1.6.45-1.9.95v-.8z',
  },
};

const { name } = Astro.props;
const icon = icons[name];
---

<svg
  class="icon"
  viewBox="0 0 16 16"
  aria-hidden="true"
  fill={icon.line ? 'none' : 'currentColor'}
  fill-rule="evenodd"
  stroke={icon.line ? 'currentColor' : undefined}
  stroke-width={icon.line ? 1.5 : undefined}
>
  <path d={icon.d}></path>
</svg>

<style>
  .icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    margin-right: 0.55em;
  }
</style>
