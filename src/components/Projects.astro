---
import Blobs from './Blobs.astro';
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import { projects } from '../data/content';
import TechBadge from './TechBadge.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const number = (i: number) => `No. ${String(i + 1).padStart(3, '0')}`;
const emptySlots = projects.length === 0 ? 3 : 0;
---

<section class="projects section" id="projects">
  <Blobs variant="projects" />
  <div class="stage-prop ladder projects__ladder" aria-hidden="true"></div>
  <div class="stage-prop floor projects__floor" data-floor="projects" aria-hidden="true">
    <span class="projects__pack" data-pack></span>
  </div>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="px section-label">{t('projects.label')}</p>
      <h2 class="section-title">{t('projects.title')}</h2>
    </header>

    <ul class="projects__grid">
      {
        projects.map((project, i) => (
          <li class="entry window" data-reveal>
            <p class="px entry__no">
              <span>{number(i)}</span>
              {project.status && <span class="entry__status">{project.status[lang]}</span>}
            </p>
            <Image
              class="entry__shot"
              src={project.image}
              alt={project.imageAlt[lang]}
              widths={[480, 800]}
              sizes="(min-width: 56rem) 22rem, 90vw"
              style={project.imagePosition ? `object-position: ${project.imagePosition}` : undefined}
            />
            <h3 class="entry__name">{project.name}</h3>
            <p class="entry__text">{project.description[lang]}</p>
            <ul class="px entry__stack">
              {project.stack.map((name) => (
                <TechBadge name={name} />
              ))}
            </ul>
            <p class="px entry__links">
              {project.url && (
                <a class="caret" href={project.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="external" />
                  {t('projects.demo')}
                </a>
              )}
              {project.repo && (
                <a class="caret" href={project.repo} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" />
                  {t('projects.repo')}
                </a>
              )}
            </p>
          </li>
        ))
      }
      {
        Array.from({ length: emptySlots }, (_, i) => (
          <li class="entry entry--unknown" data-reveal>
            <p class="px entry__no">{number(i)}</p>
            <p class="entry__mark" aria-hidden="true">
              ?
            </p>
            <h3 class="px entry__name-unknown">? ? ?</h3>
            <p class="entry__text">{t('projects.unknown')}</p>
            <p class="px entry__soon">{t('projects.soon')}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Extra room below for the wipe that rises from the contact section */
  .projects {
    /* The floor Alexis crosses on, in the gap between the stack and this section's title */
    --floor-y: calc(clamp(5rem, 12vh, 9rem) - 1rem);
    padding-bottom: calc(clamp(5rem, 12vh, 9rem) + 6rem);
    /* Its floor is the first thing in it: a jump to this section leaves air between that and the HUD */
    scroll-margin-top: 3rem;
  }

  /* The ladder from the journey ends on that floor */
  .projects__ladder {
    top: 0;
    height: var(--floor-y);
  }

  /* It stops short of the left-hand lane: he jumps off its end, with the parachute that waits there */
  .projects__floor {
    top: var(--floor-y);
    left: calc(var(--lane) + var(--prop-w) / 2 + 0.75rem);
  }

  .projects__pack {
    position: absolute;
    left: 0.25rem;
    bottom: 100%;
    width: 1rem;
    height: 1.2rem;
    background: var(--accent);
    border: 3px solid var(--ink);
    border-radius: 4px 4px 2px 2px;
    box-shadow: inset 0 3px 0 var(--paper);
  }

  .projects__pack.is-taken {
    visibility: hidden;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.5rem;
    /*
     * `translate` rather than `transform`, which belongs to the scroll reveal. Eased, not stepped: a
     * card this size moving in three jumps reads as dropped frames. The lift runs on the compositor,
     * and the card has its own layer from the start so the first frame of it has nothing to draw.
     */
    will-change: translate;
    transition:
      translate 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-radius 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Picked, like an entry under the cursor in a menu: it lifts off the page and its corners round */
  .entry.window:hover,
  .entry.window:focus-within {
    /* The reveal leaves `translate: none` inline on the card, hence the weight */
    translate: 0 -8px !important;
    border-radius: 22px;
    box-shadow:
      inset 0 0 0 3px var(--paper),
      inset 0 0 0 5px var(--accent),
      6px 14px 0 color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .entry__no {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    /* As tall with a status badge as without, so every card's screenshot starts on the same line */
    min-height: 1.625rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .entry__status {
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    color: var(--paper);
    background: var(--accent-ink);
  }

  .entry :global(.entry__shot) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-block: 0.25rem;
    border: 3px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
  }

  .entry__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .entry__text {
    color: var(--ink-2);
  }

  .entry__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8125rem;
  }


  .entry__links {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
  }

  /* Lettered as links, so they read as something to press before the cursor is over them */
  .entry__links a {
    display: inline-flex;
    align-items: center;
    padding-block: 0.5rem;
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .entry--unknown {
    border: 3px dashed color-mix(in srgb, var(--ink) 35%, transparent);
    border-radius: 12px;
    justify-items: start;
  }

  .entry__mark {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-block: 0.25rem;
    border-radius: 6px;
    background-color: var(--bg-2);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 12%, transparent) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    font-family: var(--font-pixel);
    font-size: 4rem;
    line-height: 1;
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .entry__name-unknown {
    font-size: 1.25rem;
  }

  .entry__soon {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--accent-ink);
  }
</style>
