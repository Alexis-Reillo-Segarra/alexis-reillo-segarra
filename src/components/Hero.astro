---
import Character from './Character.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [roleA, roleB] = profile.role.split(' | ');
---

<section class="hero section" id="top">
  <div class="hero__shapes" aria-hidden="true">
    <svg class="shape shape--a drift" viewBox="0 0 200 200" data-parallax="-18">
      <path
        d="M43 -58C57 -47 70 -35 76 -19C82 -3 81 16 72 32C63 47 47 59 29 67C11 75 -9 79 -27 73C-45 67 -61 52 -70 34C-79 16 -81 -5 -74 -23C-67 -41 -51 -56 -33 -66C-15 -76 5 -81 22 -76C31 -73 36 -64 43 -58Z"
        transform="translate(100 100)"></path>
    </svg>
    <svg class="shape shape--b drift" viewBox="0 0 200 200" data-parallax="-34">
      <path
        d="M48 -62C61 -52 69 -36 73 -19C77 -2 77 16 69 30C61 44 45 54 28 62C11 70 -7 76 -24 72C-41 68 -57 54 -66 37C-75 20 -77 0 -72 -18C-67 -36 -55 -52 -40 -62C-25 -72 -7 -76 9 -75C25 -74 35 -72 48 -62Z"
        transform="translate(100 100)"></path>
    </svg>
  </div>

  <div class="stage-prop floor hero__floor" data-floor="hero" aria-hidden="true"></div>
  <div class="stage-prop stage-prop--left ladder hero__ladder" aria-hidden="true"></div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="px hero__status" data-hero>
        <span class="hero__dot" aria-hidden="true"></span>
        {t('hero.available')}
      </p>
      <h1 class="hero__name" data-hero>{profile.name}</h1>
      <p class="hero__role" data-hero>
        {roleA} <span aria-hidden="true">·</span> <em>{roleB}</em>
      </p>
      <div class="hero__actions px" data-hero>
        <a class="btn btn--primary caret" href="#contact">{t('hero.cta')}</a>
        <a class="btn caret" href="#journey">{t('hero.ctaAlt')}</a>
      </div>
    </div>

    <aside class="card window" data-hero aria-label={t('hero.card')}>
      <header class="card__head px">
        <span>{t('hero.card')}</span>
        <span>No. 001</span>
      </header>
      <p class="bubble" data-bubble="card" aria-hidden="true"></p>
      <div class="card__screen" data-slot="card">
        <Character class="card__avatar" label={t('hero.avatar')} />
        <i class="card__sill" data-sill></i>
      </div>
      <dl class="card__stats px">
        <div>
          <dt>{t('hero.base')}</dt>
          <dd>{profile.location}</dd>
        </div>
        <div>
          <dt>{t('hero.status')}</dt>
          <dd>{t('hero.statusShort')}</dd>
        </div>
        <div>
          <dt>{t('hero.since')}</dt>
          <dd>{profile.activeSince}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--hud-h) + 3rem);
    overflow: hidden;
  }

  /* Behind the intro the hero waits unseen, so it comes in once (as the intro leaves) rather than showing through it first */
  :global(html[data-intro='on']) .hero [data-hero] {
    opacity: 0;
  }

  .hero__shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
  }

  .shape--a {
    width: min(46vw, 34rem);
    right: -6vw;
    top: 4%;
    fill: var(--accent);
    opacity: 0.16;
    --dx: -22%;
    --dy: 20%;
    --dr: 40deg;
    --drift-time: 28s;
  }

  .shape--b {
    width: min(30vw, 20rem);
    left: -7vw;
    bottom: -4%;
    fill: var(--olive);
    opacity: 0.18;
    --dx: 26%;
    --dy: -24%;
    --dr: -48deg;
    --drift-time: 34s;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 21rem);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .hero__dot {
    width: 0.6rem;
    height: 0.6rem;
    background: #4f9d5d;
    animation: blink 1.4s steps(1) infinite;
  }

  .hero__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__role {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    color: var(--ink-2);
  }

  .hero__role em {
    color: var(--accent-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .card {
    padding: 1.1rem;
    display: grid;
    gap: 0.9rem;
    transform: rotate(1.5deg);
  }

  .card__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-2);
    font-size: 0.8125rem;
  }

  .card__screen {
    position: relative;
    display: grid;
    place-items: end center;
    padding-top: 1.25rem;
    border: 3px solid var(--ink);
    border-radius: 6px;
    background-color: var(--bg-2);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 12%, transparent) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    overflow: hidden;
  }

  /*
   * All of him is in the card, though only the bust fits its screen: his legs hang below it, a third
   * of his height, out of sight. The stage pulls the picture back onto the whole of him, stood on
   * the sill, before he climbs out over it.
   */
  .card__screen :global(.card__avatar) {
    width: 72%;
    margin-bottom: -36%;
    transform-origin: 50% 100%;
  }

  .card__screen.is-empty :global(.card__avatar) {
    visibility: hidden;
  }

  /* The middle of the sill, for the stage to find */
  .card__sill {
    position: absolute;
    left: 50%;
    bottom: 0;
  }

  .card {
    position: relative;
  }

  /* The floor he drops onto and crosses the page on, and the top of the ladder at its far end */
  .hero__floor {
    bottom: 1.5rem;
  }

  .hero__ladder {
    bottom: 0;
    height: 1.5rem;
  }

  .card :global(.bubble) {
    right: calc(100% + 0.9rem);
    top: 5.5rem;
    width: max-content;
    max-width: 15rem;
  }

  .card :global(.bubble)::after {
    right: -9px;
    top: 1rem;
    transform: rotate(-45deg);
  }

  .card__stats {
    display: grid;
    gap: 0.35rem;
  }

  .card__stats div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px dotted var(--rule);
  }

  .card__stats dt {
    color: var(--ink-2);
  }

  @media (max-width: 55rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .card {
      max-width: 20rem;
      margin-top: 3.5rem;
      transform: none;
    }

    /* No room beside the card here, so the bubble sits above it */
    .card :global(.bubble) {
      right: auto;
      left: 0.5rem;
      top: auto;
      bottom: calc(100% + 0.8rem);
      max-width: 100%;
    }

    .card :global(.bubble)::after {
      right: auto;
      left: 2.5rem;
      top: auto;
      bottom: -9px;
      transform: rotate(45deg);
    }
  }
</style>
