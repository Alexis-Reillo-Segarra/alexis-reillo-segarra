---
import { sisyphus } from '../data/sisyphus';

/*
 * The drawing is set in type rather than shipped as a picture: it stays sharp at any size and weighs a
 * few kilobytes. Runs of glyphs that share a brightness share a span.
 */
const html = sisyphus.glyphs
  .map((row, r) => {
    let out = '';
    let run = '';
    let level = '0';
    const flush = () => {
      out += level === '0' ? run : `<span class="l${level}">${run}</span>`;
      run = '';
    };
    for (let i = 0; i < row.length; i++) {
      const next = row[i] === ' ' ? '0' : sisyphus.levels[r][i];
      if (next !== level) {
        flush();
        level = next;
      }
      run += row[i];
    }
    flush();
    return out;
  })
  .join('\n');
---

<div class="art" aria-hidden="true" data-art style={`--cols: ${sisyphus.cols}; --rows: ${sisyphus.rows}`}>
  <pre set:html={html} />
</div>

<script>
  // The drawing steps back once the reading starts, so the text that scrolls over it stays legible
  const art = document.querySelector<HTMLElement>('[data-art]');
  if (art) {
    let queued = false;
    const update = () => {
      queued = false;
      const read = Math.min(1, scrollY / (innerHeight * 0.75));
      const rest = parseFloat(getComputedStyle(art).getPropertyValue('--rest'));
      art.style.opacity = String(1 - read * (1 - rest));
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();

    if (document.documentElement.classList.contains('intro')) drawIn(art);
  }

  /*
   * On the first visit the drawing writes itself in over a bare page (Loader.astro): each glyph flickers
   * through noise before it settles, in a sweep from the man up to the boulder.
   */
  function drawIn(art: HTMLElement) {
    const SWEEP = 1100; // ms from the first glyph to the last to start
    const JITTER = 250;
    const SETTLE = 280; // ms each glyph spends as noise
    const NOISE = '.=+xX08S#@';

    const style = getComputedStyle(art);
    const cols = parseFloat(style.getPropertyValue('--cols'));
    const rows = parseFloat(style.getPropertyValue('--rows'));
    const walker = document.createTreeWalker(art.querySelector('pre')!, NodeFilter.SHOW_TEXT);
    const runs: { node: Text; text: string; at: number[] }[] = [];
    let r = 0;
    let c = 0;
    for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
      const text = node.data;
      const at: number[] = [];
      for (const ch of text) {
        if (ch === '\n') {
          r++;
          c = 0;
          at.push(-1);
          continue;
        }
        at.push(ch === ' ' ? -1 : ((c / cols + 1 - r / rows) / 2) * SWEEP + Math.random() * JITTER);
        c++;
      }
      runs.push({ node, text, at });
    }

    const start = performance.now();
    const frame = (now: number) => {
      const t = now - start;
      let done = true;
      for (const { node, text, at } of runs) {
        let out = '';
        for (let i = 0; i < text.length; i++) {
          const from = at[i];
          if (from < 0 || t >= from + SETTLE) {
            out += text[i];
          } else {
            done = false;
            out += t < from ? ' ' : NOISE[(Math.random() * NOISE.length) | 0];
          }
        }
        node.data = out;
      }
      if (done) document.dispatchEvent(new Event('art:drawn'));
      else requestAnimationFrame(frame);
    };
    frame(start);
    document.documentElement.classList.add('intro--drawing');
  }
</script>

<style>
  /* Sized in glyphs: Inconsolata is half an em wide, and the drawing fits the window either way it runs out */
  .art {
    --lh: 1.1;
    --rest: 0.18; /* opacity once the reading starts */
    position: fixed;
    z-index: 0;
    top: 50%;
    right: clamp(0rem, 9vw - 3rem, 9rem);
    translate: 0 -50%;
    font-family: var(--mono);
    font-weight: 700;
    font-size: min(88svh / (var(--rows) * var(--lh)), 58vw / (var(--cols) * 0.5));
    line-height: var(--lh);
    pointer-events: none;
    user-select: none;
  }

  /* On the first visit it sits above the loader's bare page, and keeps out of sight until it starts drawing */
  :global(html.intro) .art {
    z-index: 31;
  }

  :global(html.intro:not(.intro--drawing)) .art {
    visibility: hidden;
  }

  pre {
    margin: 0;
    font: inherit;
    text-shadow: 0 0 0.45em rgb(230 237 243 / 0.2);
  }

  .art :global(.l1) {
    color: rgb(230 237 243 / 0.14);
  }

  .art :global(.l2) {
    color: rgb(230 237 243 / 0.24);
  }

  .art :global(.l3) {
    color: rgb(230 237 243 / 0.37);
  }

  .art :global(.l4) {
    color: rgb(230 237 243 / 0.52);
  }

  .art :global(.l5) {
    color: rgb(230 237 243 / 0.7);
  }

  .art :global(.l6) {
    color: rgb(230 237 243 / 0.94);
  }

  /* Narrow screens: centred in the top half, clear of the name, and further back under the text */
  @media (max-width: 48rem) {
    .art {
      --rest: 0.1;
      top: 4.5rem;
      right: auto;
      left: 50%;
      translate: -50% 0;
      font-size: min(52svh / (var(--rows) * var(--lh)), 94vw / (var(--cols) * 0.5));
    }
  }
</style>
