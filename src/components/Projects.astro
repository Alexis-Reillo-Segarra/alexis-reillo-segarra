---
import { useTranslations, type Lang } from '../i18n/ui';
import { projects } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <h2 class="section__title" id="projects-title"><span class="n">02</span>{t('nav.projects')}</h2>
  {
    projects.length === 0 ? (
      <p class="empty">
        {t('projects.empty')}
        <span class="cursor" aria-hidden="true">_</span>
      </p>
    ) : (
      <ol class="list">
        {projects.map((project, i) => {
          const links = [
            { href: project.code, label: t('projects.code') },
            { href: project.demo, label: t('projects.demo') },
            { href: project.writeup, label: t('projects.writeup') },
          ].filter((link) => link.href);
          return (
            <li class="project">
              <h3>
                <span class="n">{String(projects.length - i).padStart(2, '0')}</span>
                {project.name}
                <span class="year">{project.year}</span>
              </h3>
              <p>{project.summary[lang]}</p>
              {project.result && <p class="result">→ {project.result[lang]}</p>}
              {links.length > 0 && (
                <ul class="links">
                  {links.map(({ href, label }) => (
                    <li>
                      <a href={href} target="_blank" rel="noopener noreferrer">
                        {label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ol>
    )
  }
</section>

<style>
  .empty {
    color: var(--muted);
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .project {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  h3 {
    display: flex;
    align-items: baseline;
    gap: 1.25ch;
    margin-bottom: 0.5rem;
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .year {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .result {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
</style>
