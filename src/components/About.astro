---
import Blobs from './Blobs.astro';
import Dialog from './Dialog.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { aboutLines, bag, profile } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="about section" id="about">
  <Blobs variant="about" />
  <div class="stage-prop stage-prop--left ladder about__ladder" data-lane="left" aria-hidden="true"></div>
  <div class="wrap about__grid">
    <h2 class="px section-label" data-reveal>{t('about.label')}</h2>

    <div class="about__box" data-reveal>
      <span class="about__nameplate px">{profile.shortName}</span>
      <Dialog lang={lang} lines={aboutLines[lang]} />
    </div>

    <div class="about__bag px" data-reveal>
      <h3 class="about__bag-title">{t('about.bag')}</h3>
      <ul>
        {bag.map((item) => <li>{item[lang]}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 1.75rem;
    max-width: 52rem;
  }

  /* Tall enough that the hero card and the journey's walker are never on screen together */
  .about {
    display: grid;
    align-items: center;
    min-height: 80svh;
  }

  /* The ladder from the hero's floor runs past, down to where the journey begins */
  .about__ladder {
    top: 0;
    bottom: 0;
  }

  .about__box {
    position: relative;
  }

  .about__nameplate {
    position: absolute;
    left: 1.25rem;
    top: 0;
    z-index: 1;
    padding: 0.1rem 0.7rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 6px;
    transform: translateY(-50%);
  }

  .about__bag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .about__bag-title {
    font: inherit;
    color: var(--ink-2);
  }

  .about__bag ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .about__bag li {
    padding: 0.3rem 0.75rem;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--paper);
  }
</style>
