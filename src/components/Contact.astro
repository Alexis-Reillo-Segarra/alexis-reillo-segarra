---
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/content';
import { icons } from '../data/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const channels = [
  { label: 'Email', icon: icons.mail, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', icon: icons.linkedin, href: profile.linkedin },
  { label: 'GitHub', icon: icons.github, href: profile.github },
  { label: 'X', icon: icons.x, href: profile.x },
];
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <h2 class="section__title" id="contact-title"><span class="n">03</span>{t('nav.contact')}</h2>
  <p class="lead">{t('contact.lead')}</p>
  <ul class="channels">
    {
      channels.map(({ label, icon, href }) => {
        const external = !href.startsWith('mailto:');
        return (
          <li>
            <a
              href={href}
              aria-label={label}
              title={label}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}>
              <svg viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
                <path d={icon} />
              </svg>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .lead {
    margin-bottom: 1.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  /* Pulled left by the links' padding, so the first icon lines up with the text above */
  .channels {
    display: flex;
    gap: 0.75rem;
    margin-left: -10px;
  }

  /* The padding makes each a 44px target around a 24px icon */
  a {
    display: block;
    padding: 10px;
    color: var(--muted);
    transition: color 0.15s ease-out, filter 0.15s ease-out;
  }

  a:hover,
  a:focus-visible {
    color: var(--fg);
    filter: drop-shadow(0 0 4px rgb(230 237 243 / 0.4));
  }

  /* 24px is the icons' own grid: one screen pixel to each of theirs */
  svg {
    display: block;
    width: 24px;
    height: 24px;
  }
</style>
